---
import HeaderLink from "./headerlink.astro";
import ThemeToggle from "./themeToggle.astro";
import MobileMenuToggle from "./mobileMenuToggle.astro";
import MobileMenuOverlay from "./mobileMenuOverlay.astro";
import { Icon } from "astro-icon/components";
---

<div class="fixed z-[100] top-0 w-full">
  <header id="site-header" class="w-full px-5 lg:px-6 py-4 transition-any">
    <nav class="flex items-center justify-between gap-2 max-w-[1600px] mx-auto">
      <a href={"/"} aria-label="Go to Home page" class="home-logo group flex items-center justify-center size-10 rounded-md bg-tertiary transition-any" transition:persist>
        <Icon name="szn" class="w-5 h-5 text-primary group-hover:rotate-180 transition-any delay-200 slow" />
      </a>

      <div class="hidden min-[769px]:flex items-center gap-1 bg-surface rounded-md h-10 px-1.5">
        <HeaderLink href="/" data="Home" />
        <HeaderLink href="/about" data="About" />
        <HeaderLink href="/playground" data="Playground" />
        <HeaderLink href="/posts" data="Writing" />
        <HeaderLink href="/contact" data="Contact" />
        <div class="w-px h-[15px] bg-secondary/30 mx-1"></div>
        <ThemeToggle />
      </div>

      <MobileMenuToggle />
    </nav>
  </header>

  <!-- Sibling of <header>, not nested inside it - see mobileMenuOverlay.astro for why. -->
  <MobileMenuOverlay />
</div>
