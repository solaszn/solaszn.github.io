---
import { Icon } from "astro-icon/components";

const themes = ["dark", "light", "clear", "bloom"] as const;
---

<button
  id="themeToggle"
  data-theme-toggle
  class="relative flex items-center justify-center size-8 rounded-md overflow-hidden hover:bg-tertiary/40 transition-any"
  aria-label="Switch theme"
  title="Switch theme"
>
  <div class="theme-dial" data-dial>
    {themes.map((theme, i) => (
      <span class="theme-dial-slot" data-dial-slot={i} data-theme-icon={theme}>
        <Icon name={theme} class="w-5 h-5" />
      </span>
    ))}
  </div>
  <span id="themeToggleLabel" class="sr-only capitalize">Dark</span>
</button>

<script>
  import { THEMES, getStoredTheme, applyTheme } from "../scripts/theme";

  function initializeThemeToggle() {
    const themeToggle = document.getElementById("themeToggle");
    const clone = themeToggle?.cloneNode(true) as HTMLElement | undefined;
    if (clone && themeToggle?.parentNode) {
      themeToggle.parentNode.replaceChild(clone, themeToggle);
    }

    const label = clone?.querySelector("#themeToggleLabel");
    const dial = clone?.querySelector<HTMLElement>("[data-dial]");
    const slots = clone?.querySelectorAll<HTMLElement>("[data-dial-slot]");

    // Accumulates forever (never reset mod 360) so the dial always spins forward - wrapping
    // from the last theme back to the first continues the same direction instead of snapping
    // backward.
    let rotationSteps = 0;

    const syncUI = (theme: string, animate = true) => {
      if (label) label.textContent = theme;
      slots?.forEach((slot) => {
        slot.toggleAttribute("data-active", slot.getAttribute("data-theme-icon") === theme);
      });

      const targetIndex = THEMES.indexOf(theme as (typeof THEMES)[number]);
      if (targetIndex === -1 || !dial) return;
      while (rotationSteps % THEMES.length !== targetIndex) rotationSteps++;

      // Negative: slot i sits fixed at i*90deg clockwise from top (see the CSS), so bringing
      // slot i to the top requires rotating the ring back by that same amount.
      if (!animate) dial.style.transitionDuration = "0ms";
      dial.style.setProperty("--dial-angle", `${rotationSteps * -90}deg`);
      if (!animate) requestAnimationFrame(() => (dial.style.transitionDuration = ""));
    };

    syncUI(getStoredTheme(), false);

    clone?.addEventListener("click", () => {
      const activeTheme = document.documentElement.dataset.theme as (typeof THEMES)[number];
      const nextIndex = (THEMES.indexOf(activeTheme) + 1) % THEMES.length;
      applyTheme(THEMES[nextIndex]);
    });

    // Stay in sync if the theme is changed elsewhere (e.g. the mobile menu's segmented control)
    window.addEventListener("themechange", ((e: CustomEvent) => syncUI(e.detail.theme)) as EventListener);
  }

  document.addEventListener("DOMContentLoaded", initializeThemeToggle);
  document.addEventListener("astro:after-swap", initializeThemeToggle);
</script>
