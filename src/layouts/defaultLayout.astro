---
import "../styles/app.css";
import BaseLayout from "../components/layout/baseLayout.astro";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import { siteConfig } from "../../site.ts";

interface Props {
  lang?: string;
  footer?: boolean;
}

const { lang="en", footer = true } = Astro.props
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseLayout title={siteConfig.title} description={siteConfig.description} image={siteConfig.image} />
  </head>

  <body class="">
    <Header />
    <slot />
    {footer && <Footer />}
  </body>
</html>
